{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "scripts/**",
      "README.md",
      "LICENSE",
      "raw/**"
    ],
    "headers": [
      {
        "source": "data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "site": "insurviz"
  }
}